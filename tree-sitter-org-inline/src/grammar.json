{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "org_inline",
  "rules": {
    "inline": {
      "type": "SYMBOL",
      "name": "title"
    },
    "title": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PREC",
            "value": 3,
            "content": {
              "type": "SYMBOL",
              "name": "bold"
            }
          },
          {
            "type": "PREC",
            "value": 3,
            "content": {
              "type": "SYMBOL",
              "name": "underline"
            }
          },
          {
            "type": "PREC",
            "value": 2,
            "content": {
              "type": "SYMBOL",
              "name": "subscript"
            }
          },
          {
            "type": "PREC",
            "value": 2,
            "content": {
              "type": "SYMBOL",
              "name": "superscript"
            }
          },
          {
            "type": "PREC",
            "value": 1,
            "content": {
              "type": "SYMBOL",
              "name": "plain_text"
            }
          }
        ]
      }
    },
    "bold": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "*"
          },
          {
            "type": "PATTERN",
            "value": "[^\\s*][^*\\n]*[^\\s*]|[^\\s*\\n]"
          },
          {
            "type": "STRING",
            "value": "*"
          }
        ]
      }
    },
    "underline": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "_"
          },
          {
            "type": "PATTERN",
            "value": "[^\\s_][^_\\n]*[^\\s_]|[^\\s_\\n]"
          },
          {
            "type": "STRING",
            "value": "_"
          }
        ]
      }
    },
    "subscript": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "PATTERN",
            "value": "[a-zA-Z0-9]+"
          },
          {
            "type": "STRING",
            "value": "_"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "*"
              },
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": "{"
                  },
                  {
                    "type": "PATTERN",
                    "value": "[^}\\n]+"
                  },
                  {
                    "type": "STRING",
                    "value": "}"
                  }
                ]
              },
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": "("
                  },
                  {
                    "type": "PATTERN",
                    "value": "[^)\\n]+"
                  },
                  {
                    "type": "STRING",
                    "value": ")"
                  }
                ]
              },
              {
                "type": "PATTERN",
                "value": "[+-]?[a-zA-Z0-9,.\\\\]*[a-zA-Z0-9]"
              }
            ]
          }
        ]
      }
    },
    "superscript": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "PATTERN",
            "value": "[a-zA-Z0-9]+"
          },
          {
            "type": "STRING",
            "value": "^"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "*"
              },
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": "{"
                  },
                  {
                    "type": "PATTERN",
                    "value": "[^}\\n]+"
                  },
                  {
                    "type": "STRING",
                    "value": "}"
                  }
                ]
              },
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": "("
                  },
                  {
                    "type": "PATTERN",
                    "value": "[^)\\n]+"
                  },
                  {
                    "type": "STRING",
                    "value": ")"
                  }
                ]
              },
              {
                "type": "PATTERN",
                "value": "[+-]?[a-zA-Z0-9,.\\\\]*[a-zA-Z0-9]"
              }
            ]
          }
        ]
      }
    },
    "plain_text": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "[^a-zA-Z0-9*_^\\n]+"
        },
        {
          "type": "PATTERN",
          "value": "[a-zA-Z0-9]+"
        },
        {
          "type": "STRING",
          "value": "*"
        },
        {
          "type": "STRING",
          "value": "_"
        },
        {
          "type": "STRING",
          "value": "^"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "STRING",
      "value": "\n"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}