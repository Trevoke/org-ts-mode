        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "{{{"
          },
          {
            "type": "SYMBOL",
            "name": "macro_name"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": "("
                  },
                  {
                    "type": "SYMBOL",
