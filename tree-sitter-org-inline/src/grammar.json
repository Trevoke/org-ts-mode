  "name": "org_inline",
  "rules": {
    "inline": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PREC_DYNAMIC",
          "value": 100,
          "content": {
            "type": "SYMBOL",
            "name": "title_with_tags"
          }
        },
        {
          "type": "PREC_DYNAMIC",
          "value": 90,
          "content": {
            "type": "SYMBOL",
            "name": "title_only"
          }
        }
      ]
    },
    "title_with_tags": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "title",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "title"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        },
        {
          "type": "FIELD",
          "name": "tags",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "TAGS"
            },
            "named": true,
            "value": "tags"
          }
        }
      ]
    },
    "title_only": {
      "type": "FIELD",
      "name": "title",
      "content": {
        "type": "SYMBOL",
        "name": "title"
      }
    },
    "title": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "REPEAT1",
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "PREC_DYNAMIC",
              "value": 60,
              "content": {
                "type": "SYMBOL",
                "name": "plain_link"
              }
            },
            {
              "type": "PREC_DYNAMIC",
              "value": 61,
              "content": {
                "type": "SYMBOL",
                "name": "angle_link"
              }
            },
            {
              "type": "PREC_DYNAMIC",
              "value": 62,
              "content": {
                "type": "SYMBOL",
                "name": "regular_link"
              }
            },
            {
              "type": "PREC_DYNAMIC",
              "value": 50,
              "content": {
                "type": "SYMBOL",
                "name": "footnote_reference"
              }
            },
            {
              "type": "PREC_DYNAMIC",
              "value": 41,
              "content": {
                "type": "SYMBOL",
                "name": "statistics_cookie"
              }
            },
            {
              "type": "PREC_DYNAMIC",
              "value": 40,
              "content": {
                "type": "SYMBOL",
                "name": "timestamp"
              }
            },
            {
              "type": "PREC_DYNAMIC",
              "value": 33,
              "content": {
                "type": "SYMBOL",
                "name": "export_snippet"
              }
            },
            {
              "type": "PREC_DYNAMIC",
              "value": 31,
              "content": {
                "type": "SYMBOL",
                "name": "radio_target"
              }
            },
            {
              "type": "PREC_DYNAMIC",
              "value": 30,
              "content": {
                "type": "SYMBOL",
                "name": "target"
              }
            },
            {
              "type": "PREC_DYNAMIC",
              "value": 32,
              "content": {
                "type": "SYMBOL",
                "name": "macro"
              }
            },
            {
              "type": "PREC_DYNAMIC",
              "value": 20,
              "content": {
                "type": "SYMBOL",
                "name": "entity"
              }
            },
            {
              "type": "PREC_DYNAMIC",
              "value": 15,
              "content": {
                "type": "SYMBOL",
                "name": "text_markup"
              }
            },
            {
              "type": "PREC_DYNAMIC",
              "value": 2,
              "content": {
                "type": "STRING",
                "value": ":"
              }
            },
            {
              "type": "PREC_DYNAMIC",
              "value": 0,
              "content": {
                "type": "SYMBOL",
                "name": "plain_text"
              }
            }
          ]
        }
      }
    },
    "text_markup": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "bold"
        },
        {
          "type": "SYMBOL",
          "name": "italic"
        },
        {
          "type": "SYMBOL",
          "name": "underline"
        },
        {
          "type": "SYMBOL",
          "name": "code"
        },
        {
          "type": "SYMBOL",
          "name": "verbatim"
        },
        {
          "type": "SYMBOL",
          "name": "strike_through"
        }
      ]
    },
    "bold": {
      "type": "PREC_DYNAMIC",
      "value": 10,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "BOLD_OPEN"
          },
          {
            "type": "REPEAT1",
            "content": {
              "type": "SYMBOL",
              "name": "_inline_element_no_bold"
            }
          },
          {
            "type": "SYMBOL",
            "name": "BOLD_CLOSE"
          }
        ]
      }
    },
    "italic": {
      "type": "PREC_DYNAMIC",
      "value": 10,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "ITALIC_OPEN"
          },
          {
            "type": "REPEAT1",
            "content": {
              "type": "SYMBOL",
              "name": "_inline_element_no_italic"
            }
          },
          {
            "type": "SYMBOL",
            "name": "ITALIC_CLOSE"
          }
        ]
      }
    },
    "underline": {
      "type": "PREC_DYNAMIC",
      "value": 10,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "UNDERLINE_OPEN"
          },
          {
            "type": "REPEAT1",
            "content": {
              "type": "SYMBOL",
              "name": "_inline_element_no_underline"
            }
          },
          {
            "type": "SYMBOL",
            "name": "UNDERLINE_CLOSE"
          }
        ]
      }
    },
    "code": {
      "type": "PREC_DYNAMIC",
      "value": 15,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "CODE_OPEN"
          },
          {
            "type": "PATTERN",
            "value": "[^\\s~][^~\\n]*[^\\s~]|[^\\s~\\n]"
          },
          {
            "type": "SYMBOL",
            "name": "CODE_CLOSE"
          }
        ]
      }
    },
    "verbatim": {
      "type": "PREC_DYNAMIC",
      "value": 15,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "VERBATIM_OPEN"
          },
          {
            "type": "PATTERN",
            "value": "[^\\s=][^=\\n]*[^\\s=]|[^\\s=\\n]"
          },
          {
            "type": "SYMBOL",
            "name": "VERBATIM_CLOSE"
          }
        ]
      }
    },
    "strike_through": {
      "type": "PREC_DYNAMIC",
      "value": 10,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "STRIKE_OPEN"
          },
          {
            "type": "REPEAT1",
            "content": {
              "type": "SYMBOL",
              "name": "_inline_element_no_strike"
            }
          },
          {
            "type": "SYMBOL",
            "name": "STRIKE_CLOSE"
          }
        ]
      }
    },
    "regular_link": {
      "type": "PREC_DYNAMIC",
      "value": 62,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "[["
          },
          {
            "type": "FIELD",
            "name": "path",
            "content": {
              "type": "PATTERN",
              "value": "[^\\]]+"
            }
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": "]["
                  },
                  {
                    "type": "FIELD",
                    "name": "description",
                    "content": {
                      "type": "PATTERN",
                      "value": "[^\\]]+"
                    }
                  }
                ]
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "STRING",
            "value": "]]"
          }
        ]
      }
    },
    "angle_link": {
      "type": "PREC_DYNAMIC",
      "value": 61,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "<"
          },
          {
            "type": "PATTERN",
            "value": "[a-zA-Z][a-zA-Z0-9+.-]*"
          },
          {
            "type": "STRING",
            "value": ":"
          },
          {
            "type": "PATTERN",
            "value": "[^>\\n]+"
          },
          {
            "type": "STRING",
            "value": ">"
          }
        ]
      }
    },
    "plain_link": {
      "type": "PREC_DYNAMIC",
      "value": 60,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "PATTERN",
            "value": "[a-zA-Z][a-zA-Z0-9+.-]*"
          },
          {
            "type": "STRING",
            "value": ":"
          },
          {
            "type": "PATTERN",
            "value": "\\/\\/[^\\s\\[\\]<>()]+|[^\\s\\[\\]<>()]+"
          }
        ]
      }
    },
    "entity": {
      "type": "PREC_DYNAMIC",
      "value": 20,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "\\"
          },
          {
            "type": "PATTERN",
            "value": "[a-zA-Z]+"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "{}"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
