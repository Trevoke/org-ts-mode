{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "org_inline",
  "rules": {
    "inline": {
      "type": "CHOICE",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "title_with_tags"
            },
            {
              "type": "SYMBOL",
              "name": "title_only"
            }
          ]
        },
        {
          "type": "BLANK"
        }
      ]
    },
    "title_with_tags": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "title",
          "content": {
            "type": "SYMBOL",
            "name": "title"
          }
        },
        {
          "type": "FIELD",
          "name": "tags",
          "content": {
            "type": "SYMBOL",
            "name": "tags"
          }
        }
      ]
    },
    "title_only": {
      "type": "FIELD",
      "name": "title",
      "content": {
        "type": "SYMBOL",
        "name": "title"
      }
    },
    "title": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PREC",
            "value": 3,
            "content": {
              "type": "SYMBOL",
              "name": "radio_target"
            }
          },
          {
            "type": "PREC",
            "value": 3,
            "content": {
              "type": "SYMBOL",
              "name": "target"
            }
          },
          {
            "type": "PREC",
            "value": 3,
            "content": {
              "type": "SYMBOL",
              "name": "macro"
            }
          },
          {
            "type": "PREC",
            "value": 3,
            "content": {
              "type": "SYMBOL",
              "name": "entity"
            }
          },
          {
            "type": "PREC",
            "value": 4,
            "content": {
              "type": "SYMBOL",
              "name": "plain_link"
            }
          },
          {
            "type": "PREC",
            "value": 3,
            "content": {
              "type": "SYMBOL",
              "name": "regular_link"
            }
          },
          {
            "type": "PREC",
            "value": 3,
            "content": {
              "type": "SYMBOL",
              "name": "angle_link"
            }
          },
          {
            "type": "PREC",
            "value": 3,
            "content": {
              "type": "SYMBOL",
              "name": "statistics_cookie"
            }
          },
          {
            "type": "PREC",
            "value": 3,
            "content": {
              "type": "SYMBOL",
              "name": "footnote_reference"
            }
          },
          {
            "type": "PREC",
            "value": 3,
            "content": {
              "type": "SYMBOL",
              "name": "timestamp"
            }
          },
          {
            "type": "PREC",
            "value": 3,
            "content": {
              "type": "SYMBOL",
              "name": "export_snippet"
            }
          },
          {
            "type": "PREC",
            "value": 2,
            "content": {
              "type": "SYMBOL",
              "name": "text_markup"
            }
          },
          {
            "type": "PREC",
            "value": 3,
            "content": {
              "type": "SYMBOL",
              "name": "subscript"
            }
          },
          {
            "type": "PREC",
            "value": 3,
            "content": {
              "type": "SYMBOL",
              "name": "superscript"
            }
          },
          {
            "type": "PREC",
            "value": 1,
            "content": {
              "type": "STRING",
              "value": ":"
            }
          },
          {
            "type": "PREC",
            "value": 1,
            "content": {
              "type": "SYMBOL",
              "name": "plain_text"
            }
          }
        ]
      }
    },
    "target": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "<<"
          },
          {
            "type": "PATTERN",
            "value": "[^<>\\n]+"
          },
          {
            "type": "STRING",
            "value": ">>"
          }
        ]
      }
    },
    "radio_target": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "<<<"
          },
          {
            "type": "PATTERN",
            "value": "[^<>\\n]+"
          },
          {
            "type": "STRING",
            "value": ">>>"
          }
        ]
      }
    },
    "macro": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{{{"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "[a-zA-Z][a-zA-Z0-9_-]*"
          },
          "named": true,
          "value": "macro_name"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "("
                },
                {
                  "type": "ALIAS",
                  "content": {
                    "type": "PATTERN",
                    "value": "[^})]+"
                  },
                  "named": true,
                  "value": "macro_args"
                },
                {
                  "type": "STRING",
                  "value": ")"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "}}}"
        }
      ]
    },
    "entity": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "\\"
          },
          {
            "type": "PATTERN",
            "value": "[a-zA-Z]+"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "{}"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "regular_link": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "[["
          },
          {
            "type": "PATTERN",
            "value": "[^\\]\\n]+"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": "]["
                  },
                  {
                    "type": "PATTERN",
                    "value": "[^\\]\\n]+"
                  }
                ]
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "STRING",
            "value": "]]"
          }
        ]
      }
    },
    "angle_link": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "<"
          },
          {
            "type": "PATTERN",
            "value": "[a-zA-Z][a-zA-Z0-9+.-]*:"
          },
          {
            "type": "PATTERN",
            "value": "[^>\\n]+"
          },
          {
            "type": "STRING",
            "value": ">"
          }
        ]
      }
    },
    "plain_link": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "[a-zA-Z][a-zA-Z0-9+.-]*:\\/\\/[^\\s]+"
          },
          {
            "type": "PATTERN",
            "value": "mailto:[^\\s]+"
          }
        ]
      }
    },
    "statistics_cookie": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "["
              },
              {
                "type": "PATTERN",
                "value": "\\d*"
              },
              {
                "type": "STRING",
                "value": "%"
              },
              {
                "type": "STRING",
                "value": "]"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "["
              },
              {
                "type": "PATTERN",
                "value": "\\d*"
              },
              {
                "type": "STRING",
                "value": "/"
              },
              {
                "type": "PATTERN",
                "value": "\\d*"
              },
              {
                "type": "STRING",
                "value": "]"
              }
            ]
          }
        ]
      }
    },
    "footnote_reference": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "[fn:"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "PATTERN",
                    "value": "[a-zA-Z0-9_-]+"
                  },
                  {
                    "type": "STRING",
                    "value": ":"
                  },
                  {
                    "type": "PATTERN",
                    "value": "[^\\]]+"
                  }
                ]
              },
              {
                "type": "PATTERN",
                "value": "[a-zA-Z0-9_-]+"
              },
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": ":"
                  },
                  {
                    "type": "PATTERN",
                    "value": "[^\\]]+"
                  }
                ]
              }
            ]
          },
          {
            "type": "STRING",
            "value": "]"
          }
        ]
      }
    },
    "timestamp": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "<"
              },
              {
                "type": "PATTERN",
                "value": "[0-9][^>]*-[^>]*"
              },
              {
                "type": "STRING",
                "value": ">"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "["
              },
              {
                "type": "PATTERN",
                "value": "\\d[^\\]]*-[^\\]]*"
              },
              {
                "type": "STRING",
                "value": "]"
              }
            ]
          }
        ]
      }
    },
    "export_snippet": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "@@"
          },
          {
            "type": "PATTERN",
            "value": "[a-zA-Z0-9-]+"
          },
          {
            "type": "STRING",
            "value": ":"
          },
          {
            "type": "PATTERN",
            "value": "[^@]*"
          },
          {
            "type": "STRING",
            "value": "@@"
          }
        ]
      }
    },
    "text_markup": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "bold"
        },
        {
          "type": "SYMBOL",
          "name": "italic"
        },
        {
          "type": "SYMBOL",
          "name": "code"
        },
        {
          "type": "SYMBOL",
          "name": "verbatim"
        },
        {
          "type": "SYMBOL",
          "name": "strike_through"
        },
        {
          "type": "SYMBOL",
          "name": "underline"
        }
      ]
    },
    "plain_text": {
      "type": "PATTERN",
      "value": "[^<{\\\\\\[@*\\/~=+_^:\\n]+"
    }
  },
  "extras": [
    {
      "type": "STRING",
      "value": "\n"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "subscript"
    },
    {
      "type": "SYMBOL",
      "name": "superscript"
    },
    {
      "type": "SYMBOL",
      "name": "tags"
    },
    {
      "type": "SYMBOL",
      "name": "bold"
    },
    {
      "type": "SYMBOL",
      "name": "italic"
    },
    {
      "type": "SYMBOL",
      "name": "code"
    },
    {
      "type": "SYMBOL",
      "name": "verbatim"
    },
    {
      "type": "SYMBOL",
      "name": "underline"
    },
    {
      "type": "SYMBOL",
      "name": "strike_through"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}