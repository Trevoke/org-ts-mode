                  },
                  {
                    "type": "STRING",
                    "value": ")"
                  }
                ]
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "STRING",
            "value": "}}}"
          }
        ]
      }
    },
    "macro_name": {
      "type": "PATTERN",
      "value": "[a-zA-Z][a-zA-Z0-9_-]*"
    },
    "macro_args": {
      "type": "PATTERN",
      "value": "[^)]+"
    },
    "export_snippet": {
      "type": "PREC_DYNAMIC",
      "value": 33,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "@@"
          },
          {
            "type": "PATTERN",
            "value": "[a-zA-Z][a-zA-Z0-9-]*"
          },
          {
            "type": "STRING",
            "value": ":"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "[^@]+"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "STRING",
            "value": "@@"
          }
        ]
      }
    },
    "footnote_reference": {
      "type": "PREC_DYNAMIC",
      "value": 50,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "[fn:"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "[a-zA-Z0-9_-]+"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": ":"
                  },
                  {
                    "type": "PATTERN",
                    "value": "[^\\]]+"
                  }
                ]
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "STRING",
            "value": "]"
          }
        ]
      }
    },
    "timestamp": {
      "type": "PREC_DYNAMIC",
      "value": 40,
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "<"
              },
              {
                "type": "PATTERN",
                "value": "\\d{4}-\\d{2}-\\d{2}[^>\\]\\n]*"
              },
              {
                "type": "STRING",
                "value": ">"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "["
              },
              {
                "type": "PATTERN",
                "value": "\\d{4}-\\d{2}-\\d{2}[^>\\]\\n]*"
              },
              {
                "type": "STRING",
                "value": "]"
              }
            ]
          }
        ]
      }
    },
    "statistics_cookie": {
      "type": "PREC_DYNAMIC",
      "value": 41,
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "["
              },
              {
                "type": "PATTERN",
                "value": "\\d*"
              },
              {
                "type": "STRING",
                "value": "%"
              },
              {
                "type": "STRING",
                "value": "]"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "["
              },
              {
                "type": "PATTERN",
                "value": "\\d*"
              },
              {
                "type": "STRING",
                "value": "/"
              },
              {
                "type": "PATTERN",
                "value": "\\d*"
              },
              {
                "type": "STRING",
                "value": "]"
              }
            ]
          }
        ]
      }
    },
    "plain_text": {
      "type": "PREC",
      "value": 0,
      "content": {
        "type": "PATTERN",
        "value": "[^*\\/~=+_:@\\[\\]<>\\\\\\{\\}\\n]+"
