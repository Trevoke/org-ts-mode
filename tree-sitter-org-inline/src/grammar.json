{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "org_inline",
  "rules": {
    "inline": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "title_only"
        },
        {
          "type": "BLANK"
        }
      ]
    },
    "title_only": {
      "type": "FIELD",
      "name": "title",
      "content": {
        "type": "SYMBOL",
        "name": "title"
      }
    },
    "title": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PREC",
            "value": 3,
            "content": {
              "type": "SYMBOL",
              "name": "radio_target"
            }
          },
          {
            "type": "PREC",
            "value": 3,
            "content": {
              "type": "SYMBOL",
              "name": "target"
            }
          },
          {
            "type": "PREC",
            "value": 1,
            "content": {
              "type": "SYMBOL",
              "name": "plain_text"
            }
          }
        ]
      }
    },
    "target": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "<<"
          },
          {
            "type": "PATTERN",
            "value": "[^<>\\n]+"
          },
          {
            "type": "STRING",
            "value": ">>"
          }
        ]
      }
    },
    "radio_target": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "<<<"
          },
          {
            "type": "PATTERN",
            "value": "[^<>\\n]+"
          },
          {
            "type": "STRING",
            "value": ">>>"
          }
        ]
      }
    },
    "plain_text": {
      "type": "PATTERN",
      "value": "[^<\\n]+"
    }
  },
  "extras": [
    {
      "type": "STRING",
      "value": "\n"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}