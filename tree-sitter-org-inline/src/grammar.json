{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "org_inline",
  "rules": {
    "inline": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "title_only"
        },
        {
          "type": "BLANK"
        }
      ]
    },
    "title_only": {
      "type": "FIELD",
      "name": "title",
      "content": {
        "type": "SYMBOL",
        "name": "title"
      }
    },
    "title": {
      "type": "SYMBOL",
      "name": "plain_text"
    },
    "plain_text": {
      "type": "PATTERN",
      "value": "[^\\n]+"
    }
  },
  "extras": [
    {
      "type": "STRING",
      "value": "\n"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}