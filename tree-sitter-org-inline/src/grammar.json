{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "org_inline",
  "rules": {
    "inline": {
      "type": "SYMBOL",
      "name": "title"
    },
    "title": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PREC",
            "value": 2,
            "content": {
              "type": "SYMBOL",
              "name": "bold"
            }
          },
          {
            "type": "PREC",
            "value": 1,
            "content": {
              "type": "SYMBOL",
              "name": "plain_text"
            }
          }
        ]
      }
    },
    "bold": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "*"
          },
          {
            "type": "PATTERN",
            "value": "[^\\s*][^*\\n]*[^\\s*]|[^\\s*\\n]"
          },
          {
            "type": "STRING",
            "value": "*"
          }
        ]
      }
    },
    "plain_text": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "[^*\\n]+"
        },
        {
          "type": "STRING",
          "value": "*"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "STRING",
      "value": "\n"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}