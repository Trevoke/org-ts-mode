            "type": "STRING",
            "value": "<<"
          },
          {
            "type": "PATTERN",
            "value": "[^<>\\n]+"
          },
          {
            "type": "STRING",
            "value": ">>"
          }
        ]
      }
    },
    "radio_target": {
      "type": "PREC_DYNAMIC",
